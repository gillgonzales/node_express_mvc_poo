<!doctype html>
<html lang="pt-BR">
<head><%- include('partials/head', { title }) %></head>
<body>
  <%- include('partials/nav', { user }) %>
  <main class="container">
    <h1>Produtos</h1>
    <p>Usuário: <%= user.name %> | <%= products.length %> registro(s)</p>
    <% if (queryError) { %><p class="error"><%= queryError %></p><% } %>
    <h2>Novo produto</h2>
    <form action="/produtos" method="post">
      <label>Nome<input name="name" required maxlength="140"></label>
      <label>Descrição<textarea name="description" rows="3"></textarea></label>
      <label>Preço<input name="price" type="number" min="0" step="0.01" required></label>
      <button type="submit">Salvar</button>
    </form>
    <h2>Registros</h2>
    <ul class="list">
      <% if (!products.length) { %><li>Nenhum produto cadastrado.</li><% } %>
      <% products.forEach((product) => { %>
        <li><strong><%= product.name %></strong> - R$ <%= Number(product.price).toFixed(2).replace('.', ',') %><br><small><%= product.description || 'Sem descrição.' %></small><form class="inline" action="/produtos/<%= product.id %>/delete" method="post"><button type="submit">Excluir</button></form></li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
