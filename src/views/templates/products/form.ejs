<!doctype html>
<html lang="pt-BR">
<head><%- include('../partials/head', { title }) %></head>
<body>
  <%- include('../partials/nav') %>
  <main class="container narrow">
    <h1><%= formTitle %></h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form action="<%= formAction %>" method="post">
      <label>Nome<input name="name" value="<%= product.name || '' %>" required maxlength="140"></label>
      <label>Descrição<textarea name="description" rows="4"><%= product.description || '' %></textarea></label>
      <label>Preço<input name="price" type="number" min="0" step="0.01" value="<%= product.price ?? '' %>" required></label>
      <button type="submit">Salvar</button> <a href="/produtos">Cancelar</a>
    </form>
  </main>
</body>
</html>